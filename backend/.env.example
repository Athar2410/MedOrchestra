# Copy to backend/.env. Everything is optional; without GROQ_API_KEY agents use rule-based fallbacks.

# --- LLM (Groq) — get a key at https://console.groq.com/keys ---
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# CRITIQUE_MODEL=qwen/qwen3.8-27b        # different model family from LLM_MODEL
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b  # used when the requested model is overloaded
# LLM_CALL_BUDGET_SECONDS=12             # default per-call budget (agents may pass smaller)
# LLM_CACHE_PATH=                        # empty disables the response cache

# --- Drug data ---
# DDINTER_DIR=data/ddinter               # filled by: python -m pipelines.download_ddinter
# RXNORM_ENABLED=true

# --- Pipeline ---
# CRITIQUE_THRESHOLD=0.60
# MAX_REROUTES=1
# STUB_DELAY_SECONDS=0.6                 # delay for agents that are still placeholders
# CORS_ORIGINS=["http://localhost:3000"]

# --- Phase 3+ (not read yet) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# DATABASE_URL=                          # Supabase Postgres connection string (pgvector)
# ICD_CLIENT_ID=                         # WHO ICD-11 API
# ICD_CLIENT_SECRET=
