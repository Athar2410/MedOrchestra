# Copy to backend/.env. All values below are optional in Phase 1.

CORS_ORIGINS=["http://localhost:3000"]
CRITIQUE_THRESHOLD=0.60
MAX_REROUTES=1
# Artificial per-agent delay so the streaming UI is visible while agents are placeholders.
STUB_DELAY_SECONDS=0.6
RUN_TIMEOUT_SECONDS=60

