# Copy to backend/.env. Everything is optional; without GROQ_API_KEY agents use rule-based fallbacks.

# --- LLM (Groq) — get a key at https://console.groq.com/keys ---
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# CRITIQUE_MODEL=qwen/qwen3.8-27b        # different model family from LLM_MODEL
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b  # used when the requested model is overloaded
# LLM_CALL_BUDGET_SECONDS=12             # default per-call budget (agents may pass smaller)
# LLM_CACHE_PATH=                        # empty disables the response cache

# --- Drug data ---
# DDINTER_DIR=data/ddinter               # filled by: python -m pipelines.download_ddinter
# RXNORM_ENABLED=true

# --- Pipeline ---
# CRITIQUE_THRESHOLD=0.60
# MAX_REROUTES=1
# STUB_DELAY_SECONDS=0.6                 # delay for agents that are still placeholders
# CORS_ORIGINS=["http://localhost:3000"]

# --- Supabase (PubMed retrieval) — Dashboard > Connect > Session pooler ---
DATABASE_URL=
# SUPABASE_URL=                          # project URL (a trailing /rest/v1/ is stripped)
# SUPABASE_SERVICE_KEY=                  # sb_secret_... (not used by code yet)

# --- PubMed / MedCPT ---
# NCBI_API_KEY=                          # 10 req/s instead of 3 for pipelines.ingest_pubmed
# RETRIEVAL_ENABLED=true
# TORCH_THREADS=12
# RERANK_POOL=12                         # cross-encoder candidates (~0.15 s each on CPU)
# MIN_RERANK_SCORE=-5                    # drop abstracts the cross-encoder scores below this
# EVIDENCE_K=8                           # abstracts shown to the Diagnostician

# --- WHO ICD-11 API — https://icd.who.int/icdapi > View API access key(s) ---
# ICD_CLIENT_ID=
# ICD_CLIENT_SECRET=
# ICD_RELEASE=2026-01
# ICD_FALLBACK_RELEASE=2025-01
